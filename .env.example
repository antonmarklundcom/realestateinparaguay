# Local MySQL (Hostinger EU/US account) — Drizzle
DATABASE_URL=mysql://user:password@localhost:3306/realestateinparaguay

# Pull-sync from inmobiliaria.com.py's export API (source of truth)
SYNC_SOURCE_API_URL=https://inmobiliaria.com.py/api/export/listings
SYNC_SOURCE_API_TOKEN=changeme

# Protects POST /api/sync (on-demand sync trigger, called by INM after writes)
SYNC_SECRET=changeme

# Forward leads captured here to INM's single admin inbox (best-effort, non-blocking)
LEADS_FORWARD_URL=https://inmobiliaria.com.py/api/leads
LEADS_FORWARD_TOKEN=changeme

# Site
NEXT_PUBLIC_SITE_URL=https://realestateinparaguay.com
NEXT_PUBLIC_WHATSAPP_NUMBER=59500000000

# Cloudinary (shared cloud with INM — public loader only, no secret needed here)
CLOUDINARY_CLOUD_NAME=changeme

# Email lead notifications
RESEND_API_KEY=changeme
LEADS_NOTIFY_EMAIL=changeme@example.com
